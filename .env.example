# Copy to `.env` for local development. Never commit the real `.env`.

# --- Database ---
DATABASE_URL=postgres://taxloss:taxloss@localhost:5432/taxloss

# --- Server ---
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,api=debug,sqlx=warn

# --- Plaid (start in sandbox) ---
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Optional: public URL Plaid POSTs webhooks to (e.g. an ngrok https URL in dev).
PLAID_WEBHOOK_URL=

# --- Encryption key for Plaid access tokens (32-byte base64), used in M2 ---
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- SMTP for email alerts (used in M5; Mailtrap recommended for dev) ---
# Email is sent only when SMTP_HOST and ALERT_EMAIL_TO are both set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@taxlossapp.local
ALERT_EMAIL_TO=

# --- Alert scheduler (6-field cron: sec min hour dom mon dow); default hourly ---
ALERT_CRON=0 0 * * * *
# Suppress alerts whose estimated tax impact is below this dollar amount.
ALERT_MIN_SAVING=50
# Flag gains within this many days of becoming long-term.
ALERT_APPROACHING_WINDOW_DAYS=30
