# Copy to `.env` for local development (gitignored — never commit the real one).
# `./run.sh` creates this file for you and generates TOKEN_ENCRYPTION_KEY; you
# only need to fill in your Plaid keys (below).

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://taxloss:taxloss@localhost:5432/taxloss

# --- Server -----------------------------------------------------------------
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,api=debug,sqlx=warn
# APP_ENV drives security posture (cookie flags, the dev-only sandbox shortcut,
# the production startup guard). Unset = development, which is correct for local
# use. Do NOT set this to `production` locally — real production deploys are
# configured via deploy/config.env, not this file.
# APP_ENV=development

# --- Plaid ------------------------------------------------------------------
# Squirrel imports holdings + transactions through Plaid. Two settings matter,
# and the distinction trips people up:
#
#   • PLAID_CLIENT_ID is the SAME in every environment (one per Plaid account).
#   • PLAID_SECRET is DIFFERENT per environment — the Plaid dashboard gives you a
#     separate "Sandbox" secret and "Production" secret. Use the one that matches
#     PLAID_ENV below, or Plaid will reject the calls.
#
# PLAID_ENV selects the environment (only `sandbox` or `production` are valid):
#
#   sandbox     → fake data, no real bank. Use your *Sandbox* secret. In Plaid
#                 Link, pick any test institution and log in with the sandbox
#                 credentials  user_good / pass_good. Free — best for trying it.
#
#   production  → real brokerages, real logins, real holdings. Use your
#                 *Production* secret (this is what a Plaid trial / production
#                 access grants). You can run this locally too: keep APP_ENV
#                 unset (development) and just set PLAID_ENV=production with your
#                 production secret.
#
# Get both keys at https://dashboard.plaid.com -> Developers -> Keys.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Optional: additional Plaid apps to shard connections across. Plaid caps live
# Items per app (the "10 connections" limit on a Plaid account), so add more
# apps (each its own Plaid account, same PLAID_ENV) to grow past it. Numbered
# from 2, contiguous; new connections route to the first app with room.
#   PLAID_CLIENT_ID_2=... / PLAID_SECRET_2=...
#   PLAID_CLIENT_ID_3=... / PLAID_SECRET_3=...
# Max live Items per app before routing to the next (defaults to 10).
PLAID_MAX_ITEMS_PER_APP=10
# Optional: public URL Plaid POSTs webhooks to (e.g. an ngrok https URL in dev).
PLAID_WEBHOOK_URL=

# --- Encryption key for stored Plaid access tokens (32-byte base64) ----------
# Required for the connect flow. `./run.sh` generates this for you; to set it by
# hand:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- SMTP for email alerts (optional; e.g. Mailtrap for dev) -----------------
# Alert emails go to each user's OWN address, and are sent only when SMTP_HOST is
# set. Leave SMTP_HOST empty to keep alerts in-app only. ALERT_EMAIL_TO is an
# optional dev-only fallback recipient — it is never used to deliver a real
# user's alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@squirrel.local
ALERT_EMAIL_TO=

# --- Alert scheduler (6-field cron: sec min hour dom mon dow); default hourly -
# Quoted because the value contains spaces (so tools that `source` .env are happy).
ALERT_CRON="0 0 * * * *"
# Suppress alerts whose estimated tax impact is below this dollar amount.
ALERT_MIN_SAVING=50
# Flag gains within this many days of becoming long-term.
ALERT_APPROACHING_WINDOW_DAYS=30
