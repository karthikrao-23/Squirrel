# Squirrel → GCP deploy configuration.
#
# Copy to `deploy/config.env` (gitignored) and fill in. All scripts source this.
# Nothing secret lives here except INTERNAL_API_TOKEN / DB_PASSWORD, which are
# pushed to Secret Manager by `secrets.sh` and never placed on a deploy command
# line — keep your local `config.env` out of version control.

# --- Project / location ------------------------------------------------------
export PROJECT_ID="your-gcp-project"
export REGION="us-central1"

# --- Artifact Registry -------------------------------------------------------
export AR_REPO="squirrel"                 # docker repo name

# --- Cloud SQL ---------------------------------------------------------------
export SQL_INSTANCE="squirrel-pg"         # instance id
export SQL_TIER="db-g1-small"             # smallest shared-core; bump as needed
export DB_NAME="squirrel"
# Two DB roles, least-privilege:
#   DB_OWNER — owns the schema, runs migrations (DDL). Created via the Cloud SQL
#              admin API (member of cloudsqlsuperuser). Used ONLY by migrate.sh.
#   DB_USER  — the runtime role the Cloud Run service connects as. A *native*
#              Postgres role (NOT a Cloud SQL admin user, so not in
#              cloudsqlsuperuser) with DML-only grants; created by migrate.sh.
export DB_OWNER="squirrel_owner"
export DB_USER="squirrel_app"
# Passwords: set in your shell before running the scripts (never commit them).
#   export DB_OWNER_PASSWORD="$(openssl rand -base64 24)"   # used by setup-infra + secrets + migrate
#   export DB_PASSWORD="$(openssl rand -base64 24)"         # runtime role; used by secrets + migrate

# --- Encryption at rest (CMEK, optional but recommended) ---------------------
# When USE_CMEK=true, setup-infra creates a Cloud KMS key you control and creates
# the Cloud SQL instance encrypted with it (CMEK is set at instance-CREATE time
# only — it can't be added to an existing instance). Leave false to use Google's
# default at-rest encryption.
export USE_CMEK="true"
export KMS_KEYRING="squirrel"
export KMS_KEY="cloudsql"

# --- Cloud Run ---------------------------------------------------------------
export RUN_SERVICE="squirrel"
export RUN_SA="squirrel-run"              # service account id (no domain)
# Posture: production | staging. PLAID_ENV is independent (sandbox|production).
export APP_ENV="production"
export PLAID_ENV="production"
# Public base URL the app is reached at (custom domain or the run.app URL).
# Used for APP_ORIGIN (CSRF) and PLAID_WEBHOOK_URL. Fill after the first deploy
# or after domain mapping, then re-run deploy.sh.
export BASE_URL="https://squirrel.example.com"

# Sizing: argon2 uses ~19 MiB per hash. Cap concurrency so peak memory is bounded
# (login/signup are rare + rate-limited). 20 × 19 MiB ≈ 380 MiB.
export RUN_MEMORY="512Mi"
export RUN_CPU="1"
export RUN_CONCURRENCY="20"
export RUN_MIN_INSTANCES="0"
export RUN_MAX_INSTANCES="3"              # hard cap (argon2 DoS / bill guard)

# --- Secrets (values supplied via env, not stored here) ----------------------
# Required in production (the app's startup guard enforces these):
#   DB_PASSWORD, DB_OWNER_PASSWORD, TOKEN_ENCRYPTION_KEY, PLAID_CLIENT_ID,
#   PLAID_SECRET, INTERNAL_API_TOKEN
# Optional: SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD, SMTP_FROM
#
#   export TOKEN_ENCRYPTION_KEY="$(openssl rand -base64 32)"
#   export INTERNAL_API_TOKEN="$(openssl rand -base64 32)"
